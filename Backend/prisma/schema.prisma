generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  HR
  INTERVIEWER
}

enum JobStatus {
  DRAFT
  OPEN
  ON_HOLD
  CLOSED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum ApplicationStatus {
  APPLIED
  SCREENING
  SHORTLISTED
  INTERVIEW_SCHEDULED
  INTERVIEWED
  SELECTED
  REJECTED
  OFFERED
  OFFER_ACCEPTED
  OFFER_REJECTED
}

enum InterviewRound {
  SCREENING
  TECHNICAL
  HR
}

enum InterviewType {
  ONLINE
  OFFLINE
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum Recommendation {
  SELECT
  HOLD
  REJECT
}

enum OfferStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  jobs          Job[]                @relation("JobCreatedBy")
  interviews    Interview[]
  statusChanges ApplicationHistory[] @relation("StatusChangedBy")

  @@map("users")
}

model Job {
  id                   Int            @id @default(autoincrement())
  jobCode              String         @unique
  title                String
  department           String
  location             String
  employmentType       EmploymentType
  description          String         @db.Text
  minimumExperience    Float
  minimumQualification String
  openings             Int
  status               JobStatus      @default(DRAFT)
  closingDate          DateTime?
  createdById          Int
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  createdBy    User          @relation("JobCreatedBy", fields: [createdById], references: [id])
  skills       JobSkill[]
  applications Application[]

  @@index([status])
  @@index([department])
  @@map("jobs")
}

model JobSkill {
  id        Int    @id @default(autoincrement())
  jobId     Int
  skillName String

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, skillName])
  @@map("job_skills")
}

model Candidate {
  id              Int      @id @default(autoincrement())
  candidateCode   String   @unique
  fullName        String
  email           String
  phone           String
  qualification   String
  experienceYears Float
  location        String
  resumeUrl       String?
  linkedinUrl     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  skills       CandidateSkill[]
  applications Application[]

  @@index([email])
  @@map("candidates")
}

model CandidateSkill {
  id          Int    @id @default(autoincrement())
  candidateId Int
  skillName   String

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([candidateId, skillName])
  @@map("candidate_skills")
}

model Application {
  id              Int               @id @default(autoincrement())
  applicationCode String            @unique
  candidateId     Int
  jobId           Int
  appliedDate     DateTime          @default(now())
  status          ApplicationStatus @default(APPLIED)
  matchScore      Float?
  screeningNotes  String?           @db.Text
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id])
  job       Job       @relation(fields: [jobId], references: [id])

  interviews Interview[]
  offer      Offer?
  history    ApplicationHistory[]

  @@unique([candidateId, jobId])
  @@index([status])
  @@index([jobId])
  @@index([candidateId])
  @@map("applications")
}

model Interview {
  id             Int             @id @default(autoincrement())
  applicationId  Int
  interviewerId  Int
  interviewRound InterviewRound
  interviewType  InterviewType
  scheduledDate  DateTime
  scheduledTime  String
  meetingLink    String?
  status         InterviewStatus @default(SCHEDULED)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  application Application        @relation(fields: [applicationId], references: [id])
  interviewer User               @relation(fields: [interviewerId], references: [id])
  feedback    InterviewFeedback?

  @@index([applicationId])
  @@index([interviewerId])
  @@map("interviews")
}

model InterviewFeedback {
  id                   Int            @id @default(autoincrement())
  interviewId          Int            @unique
  technicalRating      Int
  communicationRating  Int
  problemSolvingRating Int
  overallRating        Int
  strengths            String?        @db.Text
  weaknesses           String?        @db.Text
  recommendation       Recommendation
  comments             String?        @db.Text
  submittedAt          DateTime       @default(now())

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@map("interview_feedback")
}

model Offer {
  id            Int         @id @default(autoincrement())
  applicationId Int         @unique
  salary        Decimal     @db.Decimal(12, 2)
  joiningDate   DateTime
  offerDate     DateTime    @default(now())
  status        OfferStatus @default(DRAFT)
  notes         String?     @db.Text
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  application Application @relation(fields: [applicationId], references: [id])

  @@map("offers")
}

model ApplicationHistory {
  id            Int                @id @default(autoincrement())
  applicationId Int
  oldStatus     ApplicationStatus?
  newStatus     ApplicationStatus
  changedById   Int
  remarks       String?            @db.Text
  changedAt     DateTime           @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  changedBy   User        @relation("StatusChangedBy", fields: [changedById], references: [id])

  @@index([applicationId])
  @@map("application_history")
}
